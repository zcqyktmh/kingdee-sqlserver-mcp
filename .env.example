# Copy this file to .env and replace placeholders locally. Never commit .env.
SQLSERVER_HOST=sqlserver.example.invalid
SQLSERVER_PORT=1433
# Optional for named SQL Server instances. Leave blank to use SQLSERVER_PORT.
SQLSERVER_INSTANCE=
SQLSERVER_DATABASE=YOUR_KINGDEE_DATABASE
# Optional: query a different database than SQLSERVER_DATABASE.
KINGDEE_SQLSERVER_DATABASE=
SQLSERVER_USER=YOUR_READ_ONLY_LOGIN
SQLSERVER_PASSWORD=CHANGE_ME_LOCALLY
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
SQLSERVER_CONNECTION_TIMEOUT_MS=15000
SQLSERVER_QUERY_TIMEOUT_MS=30000
SQLSERVER_MAX_ROWS=500

